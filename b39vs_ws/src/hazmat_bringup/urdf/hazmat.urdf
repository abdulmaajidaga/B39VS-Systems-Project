<?xml version="1.0"?>
<robot name="hazmat_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Define Materials -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <!-- Central Frame (Base + Odometry) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  
  <!-- Camera Frame -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="scan_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Base footprint -->
  <link name="base_footprint" />

  <!-- Joint: Base (Fixed) -->
  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -0.035" rpy="0 0 0"/>
  </joint>
  
  <!-- Joint: Camera (Fixed) -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0 0.6" rpy="0 0 0"/>
  </joint>

  <!-- Joint: IMU (Fixed) -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.12 0 0.6" rpy="0 0 0"/>
  </joint>
  
  <!-- Joint: Lidar (Fixed) -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="scan_link"/>
    <origin xyz="0.08 0 0.6" rpy="0 0 0"/>
  </joint>
</robot>